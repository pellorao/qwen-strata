#!/usr/bin/env python3
"""Run Codex or Claude Code on the local Strata model, from lease to release.

Usage: qwen-agent [--model MODEL] [--effort high] {codex|claude} [agent arguments...]

MODEL defaults to the one model this installation serves (config/deployment.json `models`).

Takes the frontend lease (fails if someone else holds it), starts the model
(or reuses one left loaded with the same options), runs the agent with the key
in its environment, and returns the lease when the agent exits. The frontend
keeps the model loaded for the next caller and stops it after an idle period.
Needs only this installation.
"""
import argparse
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import urllib.error
import urllib.request

INSTALL = Path(__file__).resolve().parents[1]
# Total output per effort: the totals the frontend fills in for Codex (src/frontend.py EFFORT_BUDGETS).
# Claude Code always sends its own max_tokens, so it is given the same value here.
MAX_OUTPUT = {'low': 8192, 'medium': 16384, 'high': 24576}
APPROVE_TIMEOUT = 180  # seconds Claude Code waits for bin/qwen-approve


class Frontend:
    def __init__(self):
        config = json.loads((INSTALL / 'config/frontend.json').read_text(encoding='utf-8'))
        self.base = f'http://{config["listen_address"]}:{config["port"]}'
        self.key = None
        self.opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))

    def call(self, path, body=None, timeout=900):
        headers = {'Content-Type': 'application/json'}
        if self.key:
            headers['Authorization'] = 'Bearer ' + self.key
        request = urllib.request.Request(self.base + path, None if body is None else json.dumps(body).encode(), headers)
        try:
            with self.opener.open(request, timeout=timeout) as reply:
                return json.load(reply)
        except urllib.error.HTTPError as error:
            message = json.loads(error.read() or b'{}').get('error', {}).get('message', '')
            raise SystemExit(f'qwen-agent: {path} failed with HTTP {error.code}: {message}') from None


def deployment():
    return json.loads((INSTALL / 'config/deployment.json').read_text(encoding='utf-8'))


def served_model(requested=None):
    """The requested model if this installation serves it; by default its first (only) served model."""
    models = deployment().get('models') or []
    if not models:
        raise SystemExit('qwen-agent: config/deployment.json names no served model')
    if requested not in (None, *models):
        raise SystemExit(f'qwen-agent: this installation serves only {", ".join(models)}, not {requested}')
    return requested or models[0]


def default_tier(model):
    """The installation's default context tier for the model: the first one deployment.json publishes.

    Both agents get the same window and compaction threshold.  Claude Code 2.1.303 against a fake server
    compacted at 150.1K but not at 149.9K with the 206584/150000 tier, and at 100.1K but not 99.9K with 156584/100000."""
    tiers = deployment().get('context_tiers', {})
    if not tiers.get(model):
        raise SystemExit(f'qwen-agent: this installation publishes no context tier for {model}')
    return tiers[model][0]


def codex(frontend, model, effort, tier, arguments):
    config = {
        'model': model, 'model_provider': 'qwen_strata', 'model_reasoning_effort': effort,
        'model_catalog_json': str(INSTALL / 'config/model-catalog.json'),
        'model_context_window': tier['context_window'], 'model_auto_compact_token_limit': tier['auto_compact_token_limit'],
        'experimental_compact_prompt_file': str(INSTALL / 'config/prompts/compact-prompt.txt'),
        'web_search': 'live',  # served by the frontend through Brave
        'model_providers.qwen_strata.name': 'Local Strata',
        'model_providers.qwen_strata.base_url': frontend.base + '/strata/v1',
        'model_providers.qwen_strata.wire_api': 'responses',
        'model_providers.qwen_strata.env_key': 'QWEN_STRATA_KEY',
        'model_providers.qwen_strata.requires_openai_auth': False,
        'model_providers.qwen_strata.supports_websockets': False,
        'model_providers.qwen_strata.request_max_retries': 0,  # a retried request may repeat tool effects
        'model_providers.qwen_strata.stream_max_retries': 0,
    }
    overrides = [item for key, value in config.items() for item in ('-c', f'{key}={json.dumps(value)}')]
    return ['codex', *overrides, *arguments], {'QWEN_STRATA_KEY': frontend.key}


def claude(frontend, model, effort, tier, arguments):
    # Nothing may fall back to Anthropic services: search comes from the Brave MCP server,
    # WebFetch skips its Anthropic domain lookup, and approvals run on this model.
    # A PreCompact hook's stdout is appended to Claude Code's own summary instructions: the project
    # compact prompt is added to every compaction, never replacing the built-in one.
    compact = {'type': 'command', 'command': f'cat {INSTALL / "config/prompts/compact-prompt.txt"}'}
    settings = {'skipWebFetchPreflight': True, 'permissions': {'deny': ['WebSearch']},
                'hooks': {'PreCompact': [{'hooks': [compact]}]}}
    # Every permission prompt goes to bin/qwen-approve, which asks this model with its own short policy;
    # Claude Code's auto mode judged worse and slower here (reports/v0.1.40.2/agent-integration-2b).
    hook = {'type': 'command', 'command': f'{sys.executable} {INSTALL / "bin/qwen-approve"}',
            'timeout': APPROVE_TIMEOUT}
    settings['hooks']['PermissionRequest'] = [{'matcher': '*', 'hooks': [hook]}]
    servers = {'mcpServers': {'brave': {'type': 'stdio', 'command': sys.executable,
                                        'args': [str(INSTALL / 'src/brave_mcp.py')]}}}
    # --mcp-config takes several values, so a single-value option must follow it before the caller's arguments.
    options = ['--mcp-config', json.dumps(servers), '--permission-mode', 'default', '--settings', json.dumps(settings)]
    environment = {
        'ANTHROPIC_BASE_URL': frontend.base + '/strata', 'ANTHROPIC_AUTH_TOKEN': frontend.key,
        'ANTHROPIC_MODEL': model, 'ANTHROPIC_DEFAULT_OPUS_MODEL': model,
        'ANTHROPIC_DEFAULT_SONNET_MODEL': model, 'ANTHROPIC_DEFAULT_HAIKU_MODEL': model,
        'CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC': '1',
        # Unknown models are assumed to have a 200K window; declare the real limits.
        'CLAUDE_CODE_MAX_CONTEXT_TOKENS': str(tier['context_window']), 'CLAUDE_CODE_MAX_OUTPUT_TOKENS': str(MAX_OUTPUT[effort]),
        # The same effort as Codex; --effort would last only until the first compaction.
        'CLAUDE_CODE_EFFORT_LEVEL': effort,
        # Compact at Codex's threshold.  Claude Code compacts only at its blocking limit (window - 20000 - 3000:
        # 183584 for 206584, 133584 for 156584) and ignores CLAUDE_AUTOCOMPACT_PCT_OVERRIDE; this sets that limit.
        'CLAUDE_CODE_BLOCKING_LIMIT_OVERRIDE': str(tier['auto_compact_token_limit']),
    }
    return ['claude', *options, *arguments], environment


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--model', help='a model this installation serves; default: its only served model')
    parser.add_argument('--effort', choices=('low', 'medium', 'high'), default='high', help='reasoning effort for either agent')
    parser.add_argument('agent', choices=('codex', 'claude'))
    parser.add_argument('arguments', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    args.model = served_model(args.model)  # before the lease, like the tier, so a refusal holds nothing
    model = 'qwen3.8-flash-next-' + args.model.lower()
    tier = default_tier(args.model)
    frontend = Frontend()
    # A closed terminal or kill must still reach the release below.
    for name in ('SIGHUP', 'SIGTERM'):
        signal.signal(getattr(signal, name), lambda *_: sys.exit(1))
    frontend.key = frontend.call('/lease/acquire', {})['key']
    try:
        print(f'qwen-agent: starting {args.model}...', file=sys.stderr, flush=True)
        if frontend.call('/model/start', {'model': args.model, 'context_window': tier['context_window']}).get('reused'):
            print('qwen-agent: reusing the loaded model', file=sys.stderr, flush=True)
        if args.agent == 'codex':
            command, environment = codex(frontend, model, args.effort, tier, args.arguments)
        else:
            command, environment = claude(frontend, model, args.effort, tier, args.arguments)
        env = {k: v for k, v in os.environ.items() if not k.startswith(('ANTHROPIC_', 'OPENAI_'))}
        process = subprocess.Popen(command, env=dict(env, **environment))
        while True:
            try:
                code = process.wait()
                break
            except KeyboardInterrupt:
                pass  # Ctrl-C belongs to the agent; keep waiting so the lease is returned
        return code
    finally:
        try:
            frontend.call('/lease/release', {}, timeout=300)
            print('qwen-agent: lease returned; the frontend keeps the model loaded until it idles out',
                  file=sys.stderr)
        except BaseException:
            print('qwen-agent: release failed; restart the frontend task QwenStrataFrontend to free the lease',
                  file=sys.stderr)
            raise


if __name__ == '__main__':
    sys.exit(main())
