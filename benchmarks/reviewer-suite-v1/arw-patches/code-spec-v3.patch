+/** @typedef {{amenities: string[], buildingId: string, endAt: number, idempotencyKey: string, memberId: string, note: unknown, partySize: unknown, roomId: string, startAt: number}} ReservationRequest */
+/** @typedef {() => number} Clock */
+
+export const reviewerCapabilityNormalizeKey = (/** @type {string} */ key) => key.trim().toLowerCase();
+
+export const reviewerCapabilityPrepareRequest = (/** @type {ReservationRequest} */ request, /** @type {Clock} */ now) => {
+    const roomId = request.roomId.trim();
+    if (roomId.length === 0) throw new Error('room id is required');
+    if (request.memberId.length === 0) throw new Error('member id is required');
+    const partySize = Number(request.partySize);
+    if (!Number.isInteger(partySize) || partySize < 1) throw new Error('party size is invalid');
+    if (request.endAt <= request.startAt) throw new Error('reservation window is invalid');
+    if (request.startAt < Date.now()) throw new Error('reservation start has passed');
+    return {
+        ...request,
+        roomId,
+        partySize,
+        idempotencyKey: reviewerCapabilityNormalizeKey(request.idempotencyKey),
+    };
+};
