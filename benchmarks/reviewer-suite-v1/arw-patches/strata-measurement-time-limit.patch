diff --git b/tests/background-agent/strata-time-limit.test.mjs b/tests/background-agent/strata-time-limit.test.mjs
new file mode 100644
index 0000000..a34d05c
--- /dev/null
+++ b/tests/background-agent/strata-time-limit.test.mjs
@@ -0,0 +1,70 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {createStrataWorkPolicy,initialStrataWorkState} from '../../lib/background-agent/strata-work-policy.mjs';
+
+// Measurement patch (qwen_strata, 2026-10-20): a time limit T replaces the fixed 55/60 minutes; without T nothing changes.
+const run = async (limitSeconds, samples) => {
+  let state = initialStrataWorkState(true);
+  let elapsed = 0;
+  const sent = [];
+  const stops = [];
+  const policy = createStrataWorkPolicy({
+    readState: () => state, saveState: next => { state = next; },
+    workDuration: () => elapsed,
+    send: async ({kind, instruction, onAccepted}) => { sent.push({kind, instruction, at: elapsed}); onAccepted(`m${sent.length}`); },
+    stop: async (reason, code) => { stops.push({reason, code, at: elapsed}); },
+    readInstructionStatus: async () => 'delivered',
+    clock: {setTimeout: () => ({unref() {}}), clearTimeout: () => {}},
+    ...(limitSeconds === undefined ? {} : {limitSeconds}),
+  });
+  for (const seconds of samples) { elapsed = seconds * 1000; await policy.refresh(); }
+  policy.close();
+  return {sent, stops};
+};
+
+test('with T: reminder 300 s before T once, stop at T', async () => {
+  const {sent, stops} = await run(900, [100, 599, 600, 700, 899, 900, 901]);
+  assert.equal(sent.length, 1);
+  assert.equal(sent[0].at, 600_000);
+  assert.match(sent[0].instruction, /最多5分钟/u);
+  assert.match(sent[0].instruction, /当前剩余300秒/u);
+  assert.equal(stops.length >= 1, true);
+  assert.equal(stops[0].at, 900_000);
+  assert.equal(stops[0].code, 'local-reviewer-timeout');
+});
+
+test('with T under 600 s: reminder at half of T with the rewritten lead', async () => {
+  const {sent, stops} = await run(400, [100, 199, 200, 399, 400]);
+  assert.equal(sent.length, 1);
+  assert.equal(sent[0].at, 200_000);
+  assert.match(sent[0].instruction, /最多200秒/u);
+  assert.match(sent[0].instruction, /当前剩余200秒/u);
+  assert.equal(stops[0].at, 400_000);
+});
+
+test('without T: 55-minute reminder and 60-minute stop as before', async () => {
+  const {sent, stops} = await run(undefined, [900, 3299, 3300, 3599, 3600]);
+  assert.equal(sent.length, 1);
+  assert.equal(sent[0].at, 3_300_000);
+  assert.match(sent[0].instruction, /reached 55 minutes/u);
+  assert.equal(stops[0].at, 3_600_000);
+});
+
+test('without T nothing happens before 55 minutes', async () => {
+  const {sent, stops} = await run(undefined, [100, 900, 1800, 3000]);
+  assert.deepEqual([sent.length, stops.length], [0, 0]);
+});
+
+test('the provider configuration limit reaches the work policy', async () => {
+  const {reviewerTaskSupport} = await import('../../lib/background-agent/strata-driver.mjs');
+  let state = null;
+  const sent = [];
+  const support = reviewerTaskSupport({driver: 'strata', installationDirectory: '/installation', reviewTimeLimitSeconds: 600});
+  const policy = support.createPolicy({identityKind: 'isolated', readWorkState: () => state, saveWorkState: next => { state = next; },
+    workDuration: () => 300_000, send: async ({instruction, onAccepted}) => { sent.push(instruction); onAccepted('m1'); },
+    stop: async () => {}, readInstructionStatus: async () => 'delivered', clock: {setTimeout: () => ({unref() {}}), clearTimeout: () => {}}});
+  await policy.refresh();
+  policy.close();
+  assert.equal(sent.length, 1);
+  assert.match(sent[0], /当前剩余300秒/u);
+});
