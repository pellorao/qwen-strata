diff --git a/lib/reviewer-runtime/codex-mount-targets.mjs b/lib/reviewer-runtime/codex-mount-targets.mjs
new file mode 100644
index 0000000..8963612
--- /dev/null
+++ b/lib/reviewer-runtime/codex-mount-targets.mjs
@@ -0,0 +1,40 @@
+// Codex 0.163 bubblewrap creates empty synthetic mount targets for protected names (.git, .codex, .agents, .aws)
+// inside every writable root and does not always remove them (qwen_strata stubtest2, 2026-10-20). Only those exact
+// names, directly in the bound report directory, as real empty directories, are set aside; every other extra entry
+// still fails the binding. Each ignored target is logged on stderr so a measurement can count them.
+
+export const CODEX_SYNTHETIC_MOUNT_TARGETS = Object.freeze(['.git', '.codex', '.agents', '.aws']);
+
+/** @param {string} directoryPath @param {string} entryPath */
+const directChildName = (directoryPath, entryPath) => {
+    const prefix = directoryPath === '.' ? '' : `${directoryPath}/`;
+    if (!entryPath.startsWith(prefix)) return null;
+    const name = entryPath.slice(prefix.length);
+    return name && !name.includes('/') ? name : null;
+};
+
+/**
+ * The listed report-directory entries that still violate the binding once empty Codex mount targets are set aside.
+ * @param {{list: (input: {path: string, recursive: boolean}) => Promise<any>}} reviewFilesystem
+ * @param {string} directoryPath logical path of the report directory
+ * @param {Array<{kind: string, path: string}>} entries its non-recursive listing
+ * @param {string} reportLogicalPath
+ * @param {(event: object) => void} [onIgnored]
+ */
+export const unexpectedReportEntries = async (reviewFilesystem, directoryPath, entries, reportLogicalPath,
+    onIgnored = event => process.stderr.write(`${JSON.stringify(event)}\n`)) => {
+    const unexpected = [];
+    for (const entry of entries) {
+        if (entry.path === reportLogicalPath && entry.kind === 'file') continue;
+        const name = directChildName(directoryPath, entry.path);
+        if (entry.kind === 'directory' && name !== null && CODEX_SYNTHETIC_MOUNT_TARGETS.includes(name)) {
+            const inside = await reviewFilesystem.list({path: entry.path, recursive: false});
+            if (inside.status === 'succeeded' && inside.entries.length === 0) {
+                onIgnored({event: 'codex-synthetic-mount-target-ignored', path: entry.path});
+                continue;
+            }
+        }
+        unexpected.push(entry);
+    }
+    return unexpected;
+};
