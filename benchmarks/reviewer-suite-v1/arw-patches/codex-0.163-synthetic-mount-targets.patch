diff --git a/tests/reviewer-runtime/codex-mount-targets.test.mjs b/tests/reviewer-runtime/codex-mount-targets.test.mjs
new file mode 100644
index 0000000..154008a
--- /dev/null
+++ b/tests/reviewer-runtime/codex-mount-targets.test.mjs
@@ -0,0 +1,67 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {mkdir, symlink, writeFile} from 'node:fs/promises';
+import {join} from 'node:path';
+import {createScopedFilesystem} from '../../lib/common/filesystem.mjs';
+import {unexpectedReportEntries} from '../../lib/reviewer-runtime/codex-mount-targets.mjs';
+import {createTemporaryDirectory} from '../helpers/cleanup.mjs';
+
+const REPORTS = 'a/reports';
+const REPORT = `${REPORTS}/review.jsonl`;
+
+/** @param {import('node:test').TestContext} t @param {(directory: string) => Promise<void>} arrange */
+const check = async (t, arrange) => {
+    const root = await createTemporaryDirectory(t, 'codex-mount-targets-');
+    const directory = join(root, REPORTS);
+    await mkdir(directory, {recursive: true});
+    await writeFile(join(root, REPORT), '');
+    await arrange(directory);
+    const opened = (await createScopedFilesystem({root})).scopedFilesystem;
+    const listed = await opened.list({path: REPORTS, recursive: false});
+    assert.equal(listed.status, 'succeeded');
+    const ignored = [];
+    const unexpected = await unexpectedReportEntries(opened, REPORTS, listed.entries, REPORT, event => ignored.push(event.path));
+    return {unexpected: unexpected.map(entry => entry.path), ignored};
+};
+
+test('only empty Codex mount targets beside the report pass, and each one is reported', async t => {
+    const result = await check(t, async directory => {
+        for (const name of ['.git', '.codex', '.agents', '.aws']) await mkdir(join(directory, name));
+    });
+    assert.deepEqual(result.unexpected, []);
+    assert.deepEqual(result.ignored.sort(), ['.agents', '.aws', '.codex', '.git'].map(name => `${REPORTS}/${name}`));
+});
+
+test('a mount target holding a file fails', async t => {
+    const result = await check(t, async directory => {
+        await mkdir(join(directory, '.git'));
+        await writeFile(join(directory, '.git', 'HEAD'), 'x');
+    });
+    assert.deepEqual(result.unexpected, [`${REPORTS}/.git`]);
+});
+
+test('an empty directory with another name fails', async t => {
+    const result = await check(t, async directory => mkdir(join(directory, '.github')));
+    assert.deepEqual(result.unexpected, [`${REPORTS}/.github`]);
+});
+
+test('a mount target that is a symbolic link fails', async t => {
+    const result = await check(t, async directory => {
+        await mkdir(join(directory, '..', 'elsewhere'));
+        await symlink(join(directory, '..', 'elsewhere'), join(directory, '.codex'));
+    });
+    assert.deepEqual(result.unexpected, [`${REPORTS}/.codex`]);
+});
+
+test('an extra file fails even beside empty mount targets', async t => {
+    const result = await check(t, async directory => {
+        await mkdir(join(directory, '.aws'));
+        await writeFile(join(directory, 'notes.txt'), 'x');
+    });
+    assert.deepEqual(result.unexpected, [`${REPORTS}/notes.txt`]);
+});
+
+test('a mount-target name given as a file fails', async t => {
+    const result = await check(t, async directory => writeFile(join(directory, '.git'), 'gitdir: x'));
+    assert.deepEqual(result.unexpected, [`${REPORTS}/.git`]);
+});
