diff --git a/lib/reviewer-runtime/reviewer-scratch.mjs b/lib/reviewer-runtime/reviewer-scratch.mjs
new file mode 100644
index 0000000..cd6bb93
--- /dev/null
+++ b/lib/reviewer-runtime/reviewer-scratch.mjs
@@ -0,0 +1,72 @@
+// Private writable scratch for one Reviewer (qwen_strata multi-model benchmark F2, user 2026-10-20: a Reviewer must be
+// able to write and run scripts, as the Claude Code arms can in their own TMPDIR). Each Reviewer, identified by its
+// scenario root and report directory, gets <root>/<digest>: its profile grants that directory `write` and the common
+// root `none`, so no Reviewer can list, read or write another one's scratch; the command environment's TMPDIR points
+// there. The report directory and the read scope are unchanged, so the report binding check still sees only the report.
+import {createHash} from 'node:crypto';
+import {lstatSync, mkdirSync} from 'node:fs';
+import {join, resolve} from 'node:path';
+
+export const REVIEWER_SCRATCH_ROOT_VARIABLE = 'ARW_REVIEWER_SCRATCH_ROOT';
+
+/** The common scratch root: the variable above when set (tests), else /tmp/arw-reviewer-scratch-<uid>. */
+export const reviewerScratchRoot = (environment = process.env) => resolve(environment[REVIEWER_SCRATCH_ROOT_VARIABLE]
+    || `/tmp/arw-reviewer-scratch-${process.getuid?.() ?? 'user'}`);
+
+/** @param {{cwd: string, writePaths: string[]}} paths @param {string} root */
+export const reviewerScratchPath = ({cwd, writePaths}, root) => join(root,
+    createHash('sha256').update([resolve(cwd), ...writePaths.map(path => resolve(path))].join('\0')).digest('hex').slice(0, 32));
+
+const within = (/** @type {string} */ path, /** @type {string} */ base) => path === base || path.startsWith(`${base}/`);
+
+/** @param {string} path */
+const checkPrivateDirectory = path => {
+    const stat = lstatSync(path);
+    if (!stat.isDirectory() || (stat.mode & 0o777) !== 0o700 || (process.getuid && stat.uid !== process.getuid())) {
+        throw new Error(`Reviewer scratch ${path} is not this user's own 0700 directory.`);
+    }
+};
+
+/**
+ * Create (or find again, for a resumed thread) the Reviewer's scratch and return the root and the scratch path.
+ * @param {{cwd: string, readPaths: string[], writePaths: string[]}} paths
+ * @param {string} [root]
+ * @param {(event: object) => void} [onGranted]
+ */
+export const ensureReviewerScratch = (paths, root = reviewerScratchRoot(),
+    onGranted = event => process.stderr.write(`${JSON.stringify(event)}\n`)) => {
+    const scope = [paths.cwd, ...paths.readPaths, ...paths.writePaths].map(path => resolve(path));
+    if (scope.some(path => within(path, root) || within(root, path))) {
+        throw new Error('The Reviewer scratch root must lie outside the scenario root and every granted path.');
+    }
+    const scratch = reviewerScratchPath(paths, root);
+    for (const directory of [root, scratch]) {
+        try {mkdirSync(directory, {mode: 0o700});} catch (error) {
+            if (/** @type {NodeJS.ErrnoException} */ (error).code !== 'EEXIST') throw error;
+        }
+        checkPrivateDirectory(directory);
+    }
+    onGranted({event: 'reviewer-scratch-granted', path: scratch});
+    return {root, scratch};
+};
+
+/**
+ * The profile filesystem and command environment with the scratch added: the root `none`, the scratch `write`, TMPDIR.
+ * @param {Record<string, unknown>} config Codex config overrides holding the Reviewer profile
+ * @param {string} profile @param {{root: string, scratch: string}} granted
+ */
+export const withReviewerScratch = (config, profile, {root, scratch}) => {
+    const key = `permissions.${profile}.filesystem`;
+    const filesystem = /** @type {Record<string, string>} */ (config[key]);
+    if (root in filesystem || scratch in filesystem) throw new Error('The Reviewer scratch is already in the profile.');
+    if (Object.keys(config).some(name => name.startsWith('shell_environment_policy.'))) {
+        throw new Error('The Reviewer scratch needs shell_environment_policy as one table.');
+    }
+    const policy = /** @type {Record<string, any>} */ (config.shell_environment_policy ?? {});
+    if (policy === null || typeof policy !== 'object' || Array.isArray(policy)) throw new Error('Invalid shell_environment_policy.');
+    const set = {...(policy.set ?? {})};
+    if (set.TMPDIR !== undefined && set.TMPDIR !== scratch) throw new Error('TMPDIR is already set for Reviewer commands.');
+    set.TMPDIR = scratch;
+    return {...config, [key]: {...filesystem, [root]: 'none', [scratch]: 'write'},
+        shell_environment_policy: {...policy, set}};
+};
diff --git a/tests/reviewer-runtime/reviewer-scratch.test.mjs b/tests/reviewer-runtime/reviewer-scratch.test.mjs
new file mode 100644
index 0000000..37bc7e2
--- /dev/null
+++ b/tests/reviewer-runtime/reviewer-scratch.test.mjs
@@ -0,0 +1,67 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {chmod, mkdir, stat, symlink} from 'node:fs/promises';
+import {join} from 'node:path';
+import {reviewerNativeSettings} from '../../lib/reviewer-runtime/reviewer-native-policy.mjs';
+import {ensureReviewerScratch, reviewerScratchPath} from '../../lib/reviewer-runtime/reviewer-scratch.mjs';
+import {createTemporaryDirectory} from '../helpers/cleanup.mjs';
+
+/** @param {import('node:test').TestContext} t */
+const layout = async t => {
+    const base = await createTemporaryDirectory(t, 'reviewer-scratch-');
+    const cwd = join(base, 'scenario');
+    const reports = join(cwd, '.tmp', 'reports');
+    await mkdir(reports, {recursive: true});
+    return {base, cwd, reports, root: join(base, 'scratch-root')};
+};
+
+const settings = {model: 'm', modelProvider: 'p', reasoningEffort: 'low', serviceTier: 'default',
+    config: {shell_environment_policy: {inherit: 'all', exclude: ['*_API_KEY'], set: {BASH_ENV: '/x'}}}};
+
+test('the Reviewer profile grants only its own scratch, denies the common root and points TMPDIR there', async t => {
+    const {cwd, reports, root} = await layout(t);
+    const previous = process.env.ARW_REVIEWER_SCRATCH_ROOT;
+    process.env.ARW_REVIEWER_SCRATCH_ROOT = root;
+    t.after(() => { if (previous === undefined) delete process.env.ARW_REVIEWER_SCRATCH_ROOT; else process.env.ARW_REVIEWER_SCRATCH_ROOT = previous; });
+    const result = reviewerNativeSettings(/** @type {any} */ (settings), {cwd, readPaths: [], writePaths: [reports]});
+    const profile = /** @type {string} */ (result.config.default_permissions);
+    const scratch = reviewerScratchPath({cwd, writePaths: [reports]}, root);
+    assert.deepEqual(result.config[`permissions.${profile}.filesystem`], {[cwd]: 'read', [reports]: 'write', [root]: 'none', [scratch]: 'write'});
+    assert.deepEqual(result.config.shell_environment_policy,
+        {inherit: 'all', exclude: ['*_API_KEY'], set: {BASH_ENV: '/x', TMPDIR: scratch}});
+    assert.equal(((await stat(scratch)).mode & 0o777), 0o700);
+    assert.equal(((await stat(root)).mode & 0o777), 0o700);
+    // The same Reviewer (resume, restart) finds the same scratch; another report directory gets another one.
+    const again = reviewerNativeSettings(/** @type {any} */ (settings), {cwd, readPaths: [], writePaths: [reports]});
+    assert.equal(/** @type {any} */ (again.config.shell_environment_policy).set.TMPDIR, scratch);
+    assert.notEqual(reviewerScratchPath({cwd, writePaths: [join(cwd, '.tmp', 'other')]}, root), scratch);
+});
+
+test('a scratch root inside the scenario root or around it is refused', async t => {
+    const {base, cwd, reports} = await layout(t);
+    const silent = () => {};
+    assert.throws(() => ensureReviewerScratch({cwd, readPaths: [], writePaths: [reports]}, join(cwd, 'scratch'), silent), /outside the scenario root/);
+    assert.throws(() => ensureReviewerScratch({cwd, readPaths: [], writePaths: [reports]}, base, silent), /outside the scenario root/);
+});
+
+test('a scratch that is a link or not private is refused', async t => {
+    const {base, cwd, reports, root} = await layout(t);
+    const paths = {cwd, readPaths: [], writePaths: [reports]};
+    await mkdir(root, {mode: 0o700});
+    await mkdir(join(base, 'elsewhere'), {mode: 0o700});
+    await symlink(join(base, 'elsewhere'), reviewerScratchPath(paths, root));
+    assert.throws(() => ensureReviewerScratch(paths, root, () => {}), /own 0700 directory/);
+    const open = join(base, 'open-root');
+    await mkdir(open);
+    await chmod(open, 0o755);
+    assert.throws(() => ensureReviewerScratch(paths, open, () => {}), /own 0700 directory/);
+});
+
+test('an existing TMPDIR or dotted shell policy keys are refused', async t => {
+    const {cwd, reports, root} = await layout(t);
+    process.env.ARW_REVIEWER_SCRATCH_ROOT = root;
+    t.after(() => { delete process.env.ARW_REVIEWER_SCRATCH_ROOT; });
+    const paths = {cwd, readPaths: [], writePaths: [reports]};
+    assert.throws(() => reviewerNativeSettings(/** @type {any} */ ({...settings, config: {shell_environment_policy: {set: {TMPDIR: '/tmp'}}}}), paths), /TMPDIR is already set/);
+    assert.throws(() => reviewerNativeSettings(/** @type {any} */ ({...settings, config: {'shell_environment_policy.set': {}}}), paths), /one table/);
+});
