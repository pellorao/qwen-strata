+/** The installation publishes measured context tiers per model; the caller selects one by its window, else the first is the default.
+ * @param {{installationDirectory:string,modelId:string,contextWindow?:number,readText?:ReadText}} input
+ * @returns {Promise<StrataContextTier>}
+ */
+export async function readStrataContextTier({installationDirectory,modelId,contextWindow,readText=defaultReadText}) {
+  const variant=Object.hasOwn(STRATA_MODEL_VARIANTS,modelId) ? STRATA_MODEL_VARIANTS[/** @type {keyof typeof STRATA_MODEL_VARIANTS} */ (modelId)] : null;
+  if(!variant)throw new Error('Unsupported Strata model ID.');
+  let deployment;
+  try {deployment=JSON.parse(await readText(join(installationDirectory,'config','deployment.json')));}
+  catch(error){throw new Error('Strata deployment configuration is unavailable.',{cause:error});}
+  const tiers=isJsonObject(deployment)&&isJsonObject(deployment.context_tiers)?deployment.context_tiers[variant]:undefined;
+  if(!Array.isArray(tiers)||tiers.length===0)throw new Error(`Strata installation publishes no context tier for ${variant}.`);
+  const tier=contextWindow===undefined?tiers[0]:tiers.find(item=>isJsonObject(item)&&item.context_window===contextWindow);
+  if(tier===undefined)throw new Error(`Strata installation does not publish a ${contextWindow}-token context tier for ${variant}.`);
+  if(!isJsonObject(tier)||!Number.isSafeInteger(tier.context_window)||!Number.isSafeInteger(tier.auto_compact_token_limit)
+    ||!(Number(tier.auto_compact_token_limit)>0&&Number(tier.auto_compact_token_limit)<Number(tier.context_window)))
+    throw new Error(`Strata context tier for ${variant} is invalid.`);
+  return {contextWindow:Number(tier.context_window),autoCompactTokenLimit:Number(tier.auto_compact_token_limit)};
+}
+
