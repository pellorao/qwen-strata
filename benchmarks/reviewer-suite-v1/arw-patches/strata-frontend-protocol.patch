-    if (!configured || !isJsonObject(model) || !Object.hasOwn(STRATA_MODEL_VARIANTS, String(model.slug))) return model;
-    return {...model,context_window:STRATA_CONTEXT_WINDOW,max_context_window:STRATA_CONTEXT_WINDOW};
-  });
+export const applyStrataCatalogSupport = async (models, providers, readText=defaultReadText) => {
+  const provider = Object.values(providers).find(value => value.driver === 'strata');
+  if (!provider?.installationDirectory) return models;
+  const installationDirectory=provider.installationDirectory;
+  return Promise.all(models.map(async model => {
+    if (!isJsonObject(model) || !Object.hasOwn(STRATA_MODEL_VARIANTS, String(model.slug))) return model;
+    const {contextWindow}=await readStrataContextTier({installationDirectory,modelId:String(model.slug),
+      ...(provider.contextWindow===undefined?{}:{contextWindow:provider.contextWindow}),readText});
+    return {...model,context_window:contextWindow,max_context_window:contextWindow};
+  }));
 };
