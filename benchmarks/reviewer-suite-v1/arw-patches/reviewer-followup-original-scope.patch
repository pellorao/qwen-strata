+test('an unloaded Reviewer checks its original report in the original scope before a followup in another cwd', async () => {
+    const fixture = createReviewerRuntimeFixture();
+    // A provider that continues tasks (Strata) must not see the original delivered report as missing.
+    let continuations = 0;
+    const nativeSessions = {open: async (/** @type {Parameters<typeof fixture.native.nativeSessions.open>[0]} */ input) => {
+        const session = await fixture.native.nativeSessions.open(input);
+        return Object.assign(session, {continueTask: async () => {continuations++; throw new Error('Unexpected recovery continuation.');}});
+    }};
+    const runtime = createReviewerRuntime({...options(fixture), nativeSessions});
+    const receipt = succeeded(await runtime.execute({operation: 'spawn_agent', input: reviewerHandoff}));
+    const observed = succeeded(await runtime.inspect({runId: receipt.runId}));
+    const threadId = /** @type {string} */ (observed.threadId);
+    await fixture.writeReport('Original full report.');
+    fixture.native.finish(threadId);
+    assert.equal(succeeded(await runtime.inspect({runId: observed.runId})).completion?.status, 'ready');
+    fixture.native.sessions[0].environmentState = 'exited';
+    const root = fixture.native.members.get(threadId);
+    assert.ok(root);
+    root.state = 'exited';
+    const managed = await managedBinding(fixture, observed, 'exited');
+    assert.equal(succeeded(await runtime.inspect({runId: observed.runId,managed})).completion?.status, 'ready');
+    // Only the thread unloaded: the shared App Server keeps running, so the reattached thread is live again.
+    fixture.native.sessions[0].environmentState = 'running';
+    root.state = 'idle';
+    const cwd = '/second-review';
+    const reportPath = join(cwd, '.tmp', 'codex', 'test-session', 'second', 'reports', 'report.md');
+    const opened = await fixture.filesystem.open({root: cwd, createRoot: true});
+    assert.equal(opened.status, 'succeeded');
+    if (opened.status !== 'succeeded') throw new Error('Scripted second repository unavailable.');
+    const directory = relative(cwd, dirname(reportPath)).split('\\').join('/');
+    assert.equal((await opened.scopedFilesystem.createDirectory({path: directory, recursive: true})).status, 'succeeded');
+    assert.equal((await opened.scopedFilesystem.write({path: relative(cwd, reportPath).split('\\').join('/'), bytes: Buffer.alloc(0), mode: 'create'})).status, 'succeeded');
+    const accepted = succeeded(await runtime.execute({operation: 'followup_task', input: {...reviewerHandoff,
+        runId: observed.runId, cwd, reportPath, writePaths: [dirname(reportPath)]}}));
+    assert.equal(accepted.deliveryStatus, 'accepted');
+    assert.equal(continuations, 0);
+    assert.equal(fixture.native.calls.filter(call => call.operation === 'resume').length, 1);
+    const next = succeeded(await runtime.inspect({runId: accepted.runId}));
+    assert.equal(next.threadId, threadId);
+    assert.equal(fixture.native.sessions.at(-1)?.input.cwd, cwd);
+    await runtime.close();
+});
