+export const isInCheckInWindow = (guest, at) => {
+    const window = checkInWindow(guest);
+    return window.startAt <= at && at < window.endAt;
+};
+
+export const hasMissedWindow = (guest, at) => guest.state === 'registered' && at >= checkInCloses(guest);
