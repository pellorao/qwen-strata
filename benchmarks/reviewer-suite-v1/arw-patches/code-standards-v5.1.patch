diff --git a/tests/fixtures/reviewer-capability/code-standards-reviewer/scenario/base/src/payments/payment-policy.mjs b/tests/fixtures/reviewer-capability/code-standards-reviewer/scenario/base/src/payments/payment-policy.mjs
